# Copy to .env for local work on the backend, and never commit the real file.
# On Render these are set in the service's Environment tab instead.

# The whole service account JSON, on one line, starting with a brace.
FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", "...": "..."}

# Realtime Database, where the profile, storage counter and username index live.
FIREBASE_DATABASE_URL=https://eyemail-c3398-default-rtdb.asia-southeast1.firebasedatabase.app

# Outbound mail.
BREVO_API_KEY=

# The key Indo Account sends with /api/internal/send-mail.
INTERNAL_API_SECRET=

# The secret Cloudflare sends with /webhook/inbound.
WEBHOOK_SECRET=

# Sites allowed to call the API, comma separated, no spaces.
ALLOWED_ORIGINS=https://eyemail.in,https://www.eyemail.in,http://localhost:5500

# Outside mails per day, per account, on the free plan.
DAILY_EXTERNAL_LIMIT=50
