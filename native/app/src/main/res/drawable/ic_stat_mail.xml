<?xml version="1.0" encoding="utf-8"?>
<!--
  The small icon Android draws in the status bar.

  Android uses only the shape here and paints it one colour, so this must be a clean
  silhouette. The earlier version drew two filled shapes, and with the default fill rule
  the second one added to the first instead of cutting into it, so the icon came out as a
  solid rounded block with no envelope in it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- the envelope body, hollow: the outer edge kept, the inside cut away -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M4,5h16a2,2 0 0 1 2,2v10a2,2 0 0 1 -2,2H4a2,2 0 0 1 -2,-2V7a2,2 0 0 1 2,-2zM4,7v10h16V7H4z" />
    <!-- the flap, so the shape reads as a letter and not a rectangle -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M4,7.6 L12,13 L20,7.6" />
</vector>
