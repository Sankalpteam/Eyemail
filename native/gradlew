#!/bin/sh
# Minimal launcher so the repository works without a committed wrapper jar.
# GitHub Actions installs Gradle itself; locally, use your own Gradle or Android Studio.
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi
echo "Gradle is not on PATH. Open the native/ folder in Android Studio, or install Gradle 8.9." >&2
exit 1
